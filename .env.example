# PostgreSQL
POSTGRES_USER=dayflow
POSTGRES_PASSWORD=dayflow_secret
POSTGRES_DB=dayflow
DATABASE_URL=postgresql+asyncpg://dayflow:dayflow_secret@db:5432/dayflow

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=Dayflow
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:5173

# Email (dev mode logs to console)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@dayflow.app
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
